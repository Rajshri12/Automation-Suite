<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Automation Suite" parallel="methods" thread-count="3">

    <test name="UI Tests">
        <groups>
            <run><include name="ui"/></run>
        </groups>
        <classes>
            <class name="tests.ui.LoginTest"/>
        </classes>
    </test>

    <test name="API Tests">
        <groups>
            <run><include name="api"/></run>
        </groups>
        <classes>
            <class name="tests.api.AuthApiTest"/>
        </classes>
    </test>

    <test name="End-to-End Tests">
        <groups>
            <run><include name="e2e"/></run>
        </groups>
        <classes>
            <class name="tests.e2e.EndToEndWorkflowTest"/>
        </classes>
    </test>

</suite>
